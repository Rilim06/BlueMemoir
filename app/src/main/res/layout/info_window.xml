<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".infoWindow">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp"
        android:background="@drawable/rounded_input">

        <androidx.cardview.widget.CardView
            android:id="@+id/photoCardView"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_gravity="center"
            app:cardBackgroundColor="@color/font3"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:id="@+id/photoCardView2"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    app:cardBackgroundColor="@color/font3"
                    app:cardCornerRadius="16dp">

                    <ImageView
                        android:id="@+id/diaryImage"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:background="@drawable/insert_image_background"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/google" />
                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/diaryTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:fontFamily="@font/baloo"
            android:textColor="@color/font3"
            android:layout_gravity="center"
            android:paddingTop="5dp" />

    </LinearLayout>

</RelativeLayout>

