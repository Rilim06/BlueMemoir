<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/homebg"
    tools:context=".Home">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="28dp"
        android:gravity="center_horizontal">

    <View
        android:layout_width="wrap_content"
        android:layout_height="100dp"/>

        <Button
            android:id="@+id/searchButton"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_search_button"
            android:fontFamily="@font/baloo"
            android:textColor="@color/white"
            android:gravity="center"
            android:backgroundTint="@null"
            android:text="@string/search"
            android:textAllCaps="false"
            android:contentDescription="@string/google"/>

        <View
            android:layout_width="wrap_content"
            android:layout_height="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/addButton"
                android:layout_width="wrap_content"
                android:layout_height="125dp"
                android:padding="12dp"
                android:background="@drawable/add_new_button"
                android:fontFamily="@font/baloo"
                android:textColor="@color/white"
                android:gravity="center"
                android:backgroundTint="@null"
                android:text="@string/loginButton"
                android:layout_weight="0.5"
                android:contentDescription="@string/google"/>

            <ImageButton
                android:id="@+id/recentButton"
                android:layout_width="wrap_content"
                android:layout_height="120dp"
                android:padding="12dp"
                android:background="@drawable/recent_button"
                android:fontFamily="@font/baloo"
                android:textColor="@color/white"
                android:gravity="center"
                android:backgroundTint="@null"
                android:text="@string/loginButton"
                android:layout_marginTop="1dp"
                android:layout_marginEnd="7dp"
                android:layout_weight="0.5"
                android:visibility="gone"
                android:contentDescription="@string/google"/>

            <ImageButton
                android:id="@+id/oldestButton"
                android:layout_width="wrap_content"
                android:layout_height="120dp"
                android:padding="12dp"
                android:background="@drawable/oldest_button"
                android:fontFamily="@font/baloo"
                android:textColor="@color/white"
                android:gravity="center"
                android:backgroundTint="@null"
                android:text="@string/loginButton"
                android:layout_marginTop="1dp"
                android:layout_marginEnd="7dp"
                android:layout_weight="0.5"
                android:contentDescription="@string/google"/>

            <ImageButton
                android:id="@+id/seeAllButton"
                android:layout_width="wrap_content"
                android:layout_height="113dp"
                android:padding="12dp"
                android:background="@drawable/see_all_button"
                android:fontFamily="@font/baloo"
                android:textColor="@color/white"
                android:gravity="center"
                android:backgroundTint="@null"
                android:text="@string/loginButton"
                android:layout_marginTop="7dp"
                android:layout_weight="0.5"
                android:contentDescription="@string/google" />

        </LinearLayout>


        <Button
            android:id="@+id/tagButton"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:background="@drawable/tag_button"
            android:fontFamily="@font/baloo"
            android:textColor="@color/loginButton"
            android:gravity="center"
            android:backgroundTint="@null"
            android:text="@string/tag"
            android:textAllCaps="false"
            android:contentDescription="@string/google"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/homeView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="16dp"
            android:clickable="false"
            android:focusable="false"
            android:scrollbars="none" />

        <View
            android:layout_width="wrap_content"
            android:layout_height="10dp"/>

        <TextView
            android:id="@+id/noDiary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_diary"
            android:textSize="18sp"
            android:textColor="@color/font2"
            android:fontFamily="@font/baloo"
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_marginTop="100dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <View
            android:layout_width="wrap_content"
            android:layout_height="50dp"/>

    </LinearLayout>
</RelativeLayout>