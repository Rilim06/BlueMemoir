<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/profilebg"
    tools:context=".Setting">

    <!-- Setting Card Container with Frame -->
    <LinearLayout
        android:id="@+id/profile_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:layout_margin="30dp"
        android:background="@drawable/profile_frame"
        android:padding="24dp"
        android:gravity="center"
        android:elevation="4dp">

        <!-- Profile Picture -->
        <androidx.cardview.widget.CardView
            android:id="@+id/photoCardView"
            android:layout_width="95dp"
            android:layout_height="95dp"
            app:cardBackgroundColor="@color/font3"
            app:cardCornerRadius="80dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:id="@+id/photoCardView2"
                    android:layout_width="85dp"
                    android:layout_height="85dp"
                    app:cardBackgroundColor="@color/font3"
                    app:cardCornerRadius="80dp">

                    <ImageView
                        android:id="@+id/profileView"
                        android:layout_width="85dp"
                        android:layout_height="85dp"
                        android:src="@drawable/photo_no"
                        android:background="@drawable/profile_pic_background"
                        android:padding="20dp"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/google" />

                    <ImageView
                        android:id="@+id/photoView"
                        android:layout_width="85dp"
                        android:layout_height="85dp"
                        android:visibility="gone"
                        android:background="@drawable/profile_pic_background"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/google" />
                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <View
            android:layout_width="wrap_content"
            android:layout_height="5dp" />

        <ImageButton
            android:id="@+id/changeButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/circle_background"
            android:src="@drawable/change"
            android:paddingTop="0.5dp"
            android:paddingStart="0.5dp"
            android:scaleType="centerInside"
            android:contentDescription="@string/nextButton" />

        <!-- Form Section (Inside the Same Container) -->
        <LinearLayout
            android:id="@+id/form_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginTop="28dp">

            <!-- Name Field -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/label_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.4"
                    android:text="@string/name"
                    android:textSize="18sp"
                    android:textColor="@color/font3"
                    android:fontFamily="@font/baloo" />

                <EditText
                    android:id="@+id/addName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:autofillHints=" "
                    android:background="@drawable/rounded_input"
                    android:fontFamily="@font/baloo"
                    android:hint="@string/name"
                    android:minHeight="48dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:layout_weight="0.6"
                    android:textColor="@color/font7"
                    android:textColorHint="@color/font7"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- Password Field -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="6dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/label_password"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.4"
                    android:text="@string/pass"
                    android:textSize="18sp"
                    android:textColor="@color/font3"
                    android:fontFamily="@font/baloo" />

                <EditText
                    android:id="@+id/addPass"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:autofillHints=" "
                    android:background="@drawable/rounded_input"
                    android:fontFamily="@font/baloo"
                    android:hint="@string/pass"
                    android:minHeight="48dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:layout_weight="0.6"
                    android:textColor="@color/font7"
                    android:textColorHint="@color/font7"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- New Password Field -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="6dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/label_new_password"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.4"
                    android:text="@string/new_pass"
                    android:textSize="18sp"
                    android:textColor="@color/font3"
                    android:fontFamily="@font/baloo" />

                <EditText
                    android:id="@+id/addNewPass"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:autofillHints=" "
                    android:background="@drawable/rounded_input"
                    android:fontFamily="@font/baloo"
                    android:hint="@string/new_pass"
                    android:minHeight="48dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:layout_weight="0.6"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:textColor="@color/font7"
                    android:textColorHint="@color/font7"
                    android:textSize="18sp" />
            </LinearLayout>


            <!-- Notification Field (Styled like other fields) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="6dp"
                android:gravity="center_vertical">
            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="wrap_content"
            android:layout_height="20dp" />

        <Button
            android:id="@+id/saveButton"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="@string/save"
            android:background="@drawable/rounded_login_button"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:padding="8dp"
            android:textAllCaps="false"
            android:fontFamily="@font/baloo" />

        <View
            android:layout_width="wrap_content"
            android:layout_height="20dp" />

    </LinearLayout>

    <!-- Setting Frame Decor 1 -->
    <ImageView
        android:id="@+id/setting_decor_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/setting_decor_1"
        android:layout_alignParentStart="true"
        android:layout_alignTop="@id/profile_card"
        android:layout_alignStart="@id/profile_card"
        android:translationZ="10dp"
        android:layout_marginTop="2dp"
        android:layout_marginStart="20dp" />

    <!-- Setting Frame Decor 2 -->
    <ImageView
        android:id="@+id/setting_decor_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/setting_decor_2"
        android:layout_alignParentStart="true"
        android:layout_alignTop="@id/profile_card"
        android:layout_alignStart="@id/profile_card"
        android:translationZ="10dp"
        android:layout_marginStart="60dp" />

    <!-- Setting Frame Decor 3 -->
    <ImageView
        android:id="@+id/setting_decor_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/setting_decor_3"
        android:layout_alignParentStart="true"
        android:translationZ="20dp"
        android:layout_alignBottom="@id/profile_card"
        android:layout_alignEnd="@id/profile_card"
        android:layout_marginTop="700dp"
        android:layout_marginStart="300dp" />

    <!-- Setting Frame Decor 4 -->
    <ImageView
        android:id="@+id/setting_decor_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/setting_decor_4"
        android:layout_alignParentStart="true"
        android:translationZ="10dp"
        android:layout_alignBottom="@id/profile_card"
        android:layout_alignEnd="@id/profile_card"
        android:layout_marginTop="700dp"
        android:layout_marginStart="340dp" />

</RelativeLayout>