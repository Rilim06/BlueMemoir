<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FB">

    <!-- Decorative Background -->
    <ImageView
        android:id="@+id/decorative_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/home05"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentBottom="true"
        android:contentDescription="Decorative Background" />

    <!-- Setting Frame Decor 1 -->
    <ImageView
        android:id="@+id/setting_decor_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/setting_decor_1"
        android:layout_alignParentStart="true"
        android:translationZ="10dp"
        android:layout_marginTop="150dp"
        android:layout_marginStart="5dp" />

    <!-- Setting Frame Decor 2 -->
    <ImageView
        android:id="@+id/setting_decor_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/setting_decor_2"
        android:layout_alignParentStart="true"
        android:translationZ="10dp"
        android:layout_marginTop="148dp"
        android:layout_marginStart="50dp" />

    <!-- Setting Frame Decor 3 -->
    <ImageView
        android:id="@+id/setting_decor_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/setting_decor_3"
        android:layout_alignParentStart="true"
        android:translationZ="10dp"
        android:layout_marginTop="680dp"
        android:layout_marginStart="340dp" />

    <!-- Setting Frame Decor 4 -->
    <ImageView
        android:id="@+id/setting_decor_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/setting_decor_4"
        android:layout_alignParentStart="true"
        android:translationZ="10dp"
        android:layout_marginTop="700dp"
        android:layout_marginStart="320dp" />



    <!-- Back Button -->
    <ImageView
        android:id="@+id/back_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/back_button"
        android:layout_margin="16dp"
        android:contentDescription="Back"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true" />

    <!-- Profile Section Centered Vertically -->
    <LinearLayout
        android:id="@+id/setting_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center"
        android:background="@drawable/setting_frame"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">

        <!-- Profile Picture with Change Button Overlay -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center">

            <ImageView
                android:id="@+id/profile_avatar"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:src="@drawable/profile_picture"
                android:contentDescription="Profile Picture"
                android:scaleType="centerCrop" />

            <!-- Change Profile Button -->
            <ImageButton
                android:id="@+id/change_profile_picture_button"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/change_profile_picture"
                android:background="@null"
                android:layout_gravity="bottom|end"
                android:layout_marginBottom="-8dp"
                android:contentDescription="Change Profile Picture Button" />
        </FrameLayout>

        <!-- Name -->
        <TextView
            android:id="@+id/profile_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Name"
            android:fontFamily="@font/baloo"
            android:textSize="30sp"
            android:textColor="@color/font2"
            android:layout_marginTop="12dp"
            android:layout_gravity="center" />

        <!-- Email -->
        <TextView
            android:id="@+id/profile_email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="dummy@gmail.com"
            android:fontFamily="@font/baloo"
            android:textSize="14sp"
            android:textColor="@color/lightgrey"
            android:layout_gravity="center" />

        <!-- Form Section (Inside the Same Container) -->
        <LinearLayout
            android:id="@+id/form_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginTop="28dp">

            <!-- Name Field -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/label_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Name"
                    android:textSize="14sp"
                    android:textColor="@color/font2"
                    android:fontFamily="@font/baloo" />

                <EditText
                    android:id="@+id/edit_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:background="@drawable/input_setting"
                    android:textSize="14sp"
                    android:padding="8dp"
                    android:fontFamily="@font/baloo"
                    android:textColor="@android:color/black" />
            </LinearLayout>

            <!-- Email Field -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="6dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/label_email"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Email"
                    android:textSize="14sp"
                    android:textColor="@color/font2"
                    android:fontFamily="@font/baloo" />

                <EditText
                    android:id="@+id/edit_email"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:background="@drawable/input_setting"
                    android:textSize="14sp"
                    android:padding="8dp"
                    android:fontFamily="@font/baloo"
                    android:textColor="@android:color/black" />
            </LinearLayout>

            <!-- Password Field -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="6dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/label_password"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Password"
                    android:textSize="14sp"
                    android:textColor="@color/font2"
                    android:fontFamily="@font/baloo" />

                <EditText
                    android:id="@+id/edit_password"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:background="@drawable/input_setting"
                    android:inputType="textPassword"
                    android:textSize="14sp"
                    android:padding="8dp"
                    android:fontFamily="@font/baloo"
                    android:textColor="@android:color/black" />
            </LinearLayout>

            <!-- New Password Field -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="6dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/label_new_password"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="New Password"
                    android:textSize="14sp"
                    android:textColor="@color/font2"
                    android:fontFamily="@font/baloo" />

                <EditText
                    android:id="@+id/edit_new_password"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:background="@drawable/input_setting"
                    android:inputType="textPassword"
                    android:textSize="14sp"
                    android:padding="8dp"
                    android:fontFamily="@font/baloo"
                    android:textColor="@android:color/black" />
            </LinearLayout>


            <!-- Notification Field (Styled like other fields) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="6dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/label_notification"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Notification"
                    android:textSize="14sp"
                    android:textColor="@color/font2"
                    android:fontFamily="@font/baloo" />

                <Button
                    android:id="@+id/button_notification"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="Allow"
                    android:background="@drawable/input_setting"
                    android:textColor="@android:color/black"
                    android:textSize="14sp"
                    android:padding="8dp"
                    android:fontFamily="@font/baloo"
                    android:clickable="true" />
            </LinearLayout>



        </LinearLayout>

        <!-- Save Button -->
        <ImageView
            android:id="@+id/save_button"
            android:layout_width="120dp"
            android:layout_height="42dp"
            android:src="@drawable/save_button"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp"
            android:layout_gravity="center"
            android:contentDescription="Save Button" />
    </LinearLayout>

</RelativeLayout>
