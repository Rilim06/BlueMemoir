<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <layer-list>
            <item>
                <bitmap android:src="@drawable/recent_click" android:gravity="fill" />
            </item>
            <item>
                <shape>
                    <corners android:topLeftRadius="32dp" android:topRightRadius="32dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item>
        <layer-list>
            <item>
                <bitmap android:src="@drawable/recent" android:gravity="fill" />
            </item>
            <item>
                <shape>
                    <corners android:topLeftRadius="32dp" android:topRightRadius="32dp" />
                </shape>
            </item>
        </layer-list>
    </item>

</selector>
